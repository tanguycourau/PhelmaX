#!/bin/sh
System=`uname`
if [ $System = "Darwin" ] ; then
  System="DarwinGnu"
  #fi
elif [ $System = "Linux" ] ; then
  Processor=`uname -m`
  if [ $Processor = "x86_64" ] ; then
    System="Linux64"
  fi
fi
Sysx="`echo $System | cut -b -6`"
if [ $Sysx = "CYGWIN" ]; then
	System=`uname -o`
fi
if [ $System = "Linux64" ] ; then 
    EXEC=$HOME/Codes/Version5_beta_ev2420/Dragon/bin/Linux_x86_64/Dragon
    EXEC=$HOME/Codes/Version5.1/Dragon/bin/Linux_x86_64/Dragon
fi
if [ $System = "Linux64" ] ; then 
  iaea=$HOME/Codes/DragonLib/iaea
  iaeagx=$HOME/Codes/DragonLib/iaeagx
  L295b7r1=$HOME/Codes/DragonNeaLib/draglibendfb7r1SHEM295_v5p1 # not working
  L295j3p1=$HOME/Codes/DragonNeaLib/draglibJeff3p1p1SHEM295_v5p1
  L99j3p1=$HOME/Codes/DragonNeaLib/draglibJeff3p1p1Apolib99_v5p1
fi
# 
#  DRAGON distribution file: rdshort
#
#  Warning: rdshort is not a full script. It must be processed
#           by setup to generate the script rundragon which
#           can then be used for execution
#  
#  The current script is not sufficient to execute by itself
#  and must be proceeded by instructions such as
#
#!/bin/sh
#  EXEC=/Users/Dragon/bin/AIX/dragonFev01U
#  iaea=/Users/Dragon/Libraries/AIX/iaea69
#
#
#  rdshort contains a reduced version of the complete rdragon script
#  used at Ecole Polytechnique de Montreal.
#  The rdragon script on which rdshort is based was written by R. Roy.
#  It can deal with procedures, multiple library and multiple code version.
#  
#  which are generated by the setup script in the main dragon
#  directory 
#  It executes in the current directory insteead of temporary
#  directory such as /tmp or /usr/tmp
#   
#  Because it is distributed with a single version of DRAGON
#  the options in the original rdragon dealing with possible use
#  of multiple version was eliminated
#
INPTPath=`pwd` 
TMPDIR=$INPTPath
#
#  Define executable and cross sections libraries for current system
#
INPUT="No"
OUTNAM=""
NICE="Yes"
SUFFIX="+"
PREDIR="No"
PREFIL="No"
ALLFILE=
ALLDIR=
PRCLIST="No"
for param in $* ; do
  case $param in
    -l*) PRCLIST="Yes" ;;
    -s*) SUFFIX="`echo $1 | cut -c 3-`" ;;
    -t*) TMPDIR="`echo $1 | cut -c 3-`" ;;
    -w*) OUTNAM="`echo $1 | cut -c 3-`"
         if [ -z "$OUTNAM" ]; then	
           NICE="No"
         fi ;;
      *) if [ -f $1 ]; then
           if [ $INPUT = "Yes" ]; then
             ALLFILE="$ALLFILE $1"
             PREFIL="Yes"
           else
             MAIN=$1 
             INPUT="Yes"
           fi
		      	elif [ -f ${1}.x2m ]; then
				       if [ $INPUT = "Yes" ]; then
				        	ALLFILE="$ALLFILE ${1}.x2m"
             PREFIL="Yes"
           else
             MAIN=${1}.x2m 
             INPUT="Yes"
           fi
			      elif [ -f ${1}.c2m ]; then
				       ALLFILE="$ALLFILE ${1}.c2m"
         elif [ -d $1 ]; then
           ALLDIR="$ALLDIR $1"
           PREDIR="Yes"
         else
           echo "This file is not a proc:" $1
           exit 1
         fi ;;
  esac
  shift
done
#
# check if main input files exist. 
#
if [ $INPUT = "Yes" ]; then
  echo "Main input  :" $MAIN
else
  echo "Main input  " $MAIN "not found."
  exit 1
fi
#
# check if executable exists.
if [ -x $EXEC ]; then
  echo "Executable  :" $EXEC
else
  echo "Executable  " $EXEC "not found."
  exit 1
fi
#
# create execution directory
#
inum=1
while [ -d $TMPDIR/rundir$inum ]
  do 
  inum=`expr $inum + 1 `
done
RUNDIR=$TMPDIR/rundir$inum
mkdir $RUNDIR
echo "RunDirectory:" $RUNDIR
#
# determine the name of the main input file
#
NEWINP=p$$
cp $MAIN $RUNDIR/$NEWINP
#
# get the proc files from directories in the ALLDIR list
#
if [ $PREDIR = "Yes" ] ; then
  for DPROC in $ALLDIR ; do
    for FullPROC in $DPROC/* ; do
      if [ ! -d $FullPROC -a -f $FullPROC ]; then
        LocPROC="`basename $FullPROC`"
        cp  $DPROC/$LocPROC $RUNDIR/$LocPROC
      fi
    done
  done
fi
#
# get the proc files from files in the ALLFILE list
#
if [ $PREFIL = "Yes" ] ; then
  for FullPROC in $ALLFILE ; do
    if [ -f $FullPROC ]; then
      LocPROC="`basename $FullPROC`"
      NewPROC=$LocPROC
      if [ -z "$NewPROC" ]; then
        echo "File" $FullPROC "cannot be copied in" $RUNDIR
        exit 1
      else
        cp $FullPROC $RUNDIR/$NewPROC
      fi
    fi
  done
fi
# 
# link cross-section libraries for DRAGON
# 
if [ -f $iaea ]; then
  ln -s  $iaea $RUNDIR/iaea
fi
if [ -f $iaeagx ]; then
  ln -s  $iaeagx $RUNDIR/iaeagx
fi
if [ -f $L295b7r1 ]; then
  ln -s  $L295b7r1 $RUNDIR/L295b7r1
fi
if [ -f $L295j3p1 ]; then
  ln -s  $L295j3p1 $RUNDIR/L295j3p1
fi
if [ -f $L99j3p1 ]; then
  ln -s  $L99j3p1 $RUNDIR/L99j3p1
fi



NewEXEC=p$$e
ln -s $EXEC $RUNDIR/$NewEXEC
cd $RUNDIR
#
# keep old list of files in the directory
#
ls -l * >p$$o
OUTFIL=p$$pr
#
# execute the code:
# 
if [ $NICE = "Yes" ]; then
  echo "**:     EXECUTION SUMMARY" >$OUTFIL 
  echo "**:"                      >>$OUTFIL
  echo "**:CMD " rundragon $MAIN  >>$OUTFIL 
  echo "**:MAC " `uname`          >>$OUTFIL
#  echo "**:USR " `whoami`         >>$OUTFIL
#  echo "**:PWD " $INPTPath        >>$OUTFIL
  echo "**:EXEC" $EXEC            >>$OUTFIL
  echo "**:DATE" `date`           >>$OUTFIL
  echo "**:"                      >>$OUTFIL
  echo "**:"                      >>$OUTFIL
  nice $RUNDIR/$NewEXEC <$NEWINP  >>$OUTFIL
else
  $RUNDIR/$NewEXEC <$NEWINP
fi
rm $NewEXEC
if [ -f core ]; then
  rm core
  echo "EXECUTION ERROR: core REMAININGS"
  SUFFIX="-"
fi
if [ -f _FIL001 ]; then
  rm _FIL001
  echo "EXECUTION ERROR: STAC REMAININGS"
  SUFFIX="-"
fi
if [ $NICE = "Yes" -a -f $OUTFIL ]; then
  echo "Output file :" $MAIN$SUFFIX$OUTNAM
  mv $OUTFIL $INPTPath/$MAIN$SUFFIX$OUTNAM
fi
rm $NEWINP
if [ -f $iaea ]; then
  rm iaea
fi
if [ -f $iaeagx ]; then
  rm iaeagx
fi

touch xxxxx.o2m xxxxx.c2m
NEWLIST=`ls *.o2m *.c2m` 
for NEWFIL in $NEWLIST
do
  /bin/rm -f $NEWFIL
done
if [ $PRCLIST = "No" ] ; then 
  touch xxxxx.l2m 
  NEWLIST=`ls *.l2m` 
  for NEWFIL in $NEWLIST
  do
    /bin/rm -f $NEWFIL
  done
fi
#
# keep new list of files in the directory
#
ls -l * >p$$n 
NEWF=`diff -e -b p$$o p$$n | awk '{ if (NF>1) print $NF }'`
for NEWFIL in $NEWF ; do
  if [ $NEWFIL !=  p$$o ]; then
    echo "New files   :" $MAIN$SUFFIX$NEWFIL
    mv $NEWFIL $INPTPath/$MAIN$SUFFIX$NEWFIL
  fi
done
#
# remove execution directory
# 
cd ..
rm -r $RUNDIR   
cd $INPTPath

