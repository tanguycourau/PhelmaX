*---------------------------------------------------------------------------
*
* Deuxieme input DRAGON
* 
* Avec procedure "GeoCellule" "Geometries" et "MixFuelCell"
*
*---------------------------------------------------------------------------

*---------------------------------------------------------------------------
* Declaration des objets, des fichiers et des procedures
*---------------------------------------------------------------------------

    LINKED_LIST GeoCell GeoAss GeoBis      ! Geometries considerees 
                NXTTracking SYBILTrk       ! Tracking pour les lignes d'integration
                XSLib XSLibAutop           ! XS par milieu
                Pij Flx Edition ;          ! Pij, Flux et Edition
                 
   SEQ_BINARY Lignes ;                     ! Binaire pour les segments d'integration
   SEQ_ASCII Fig1 :: FILE 'Fig1.ps' ;
   SEQ_ASCII Fig2 :: FILE 'Fig2.ps' ;
   SEQ_ASCII Fig3 :: FILE 'Fig3.ps' ;      ! Nom fichier figure
   SEQ_ASCII Edit :: FILE './edit' ;       ! Fichier de sortie pour Edition
   


   PROCEDURE GeoCellule Geometries         ! Fonction pour la construction des geometries
             MixFuelCell ;                 ! Fonction pour la definition des materiaux


   MODULE GEO: PSP: END: NXT: ASM: FLU: DELETE: USS: 
          SYBILT: EDI:   ;                 ! GEO pour la construction de la geo
                                           ! PSP pour l'edition de figure
                                           ! NXT pour le tracking
                                           ! ASM pour le calcul des Pij
                                           ! FLU pour la resolution du transport
                                           ! USS pour l'autoprotection
                                           ! SYBILT pour le tracking de l'autop
                                           ! EDI pour l'edition 

*---------------------------------------------------------------------------
* Definition des variables
*---------------------------------------------------------------------------
    STRING Library := "L99j3p1" ;         ! Pour les donnees nucleaire
    REAL Enri      := 3.25E-2    ;
    REAL ppmB      := 650.0        ;


*---------------------------------------------------------------------------
* Definition de la geometrie
*---------------------------------------------------------------------------
    GeoCell  := GeoCellule :: ;
    GeoAss GeoBis  := Geometries :: ;
    ECHO "Geometrie OK" ; 

    XSLib := MixFuelCell :: <<Library>> <<Enri>> <<ppmB>>  ;
    ECHO "Definition des mixtures OK" ;

*---------------------------------------------------------------------------
* Tracking Calcul Pij et Calcul Flux 
*---------------------------------------------------------------------------
    NXTTracking Lignes := NXT: GeoAss :: EDIT 0 TISO 5 50.0 ;
    SYBILTrk := SYBILT: GeoCell :: EDIT 0 DP01 MAXR 500 MAXZ 1000000 ; 
    ECHO "Calcul Tracking OK" ; 

    XSLibAutop := USS: XSLib SYBILTrk :: EDIT 0 PASS 3 MAXST 100 ; 
    ECHO "Calcul Autop OK" ;

    Pij := ASM: XSLibAutop NXTTracking Lignes :: EDIT 0 ; 
    ECHO "Calcul Pij OK" ; 

    Flx := FLU: Pij XSLibAutop NXTTracking :: TYPE B B1 SIGS ; 
    ECHO "Calcul Flux OK" ;
    Edition := EDI: Flx XSLibAutop NXTTracking :: EDIT 0
    MERG COMP COND NONE SAVE ;
    Edit := Edition ;

*---------------------------------------------------------------------------
* Visualisation des Geometries
*---------------------------------------------------------------------------
    Fig1 := PSP: GeoCell :: EDIT 0 TYPE MIXTURE ;
    Fig2 := PSP: GeoAss  :: EDIT 0 TYPE MIXTURE ; 
    Fig3 := PSP: GeoBis  :: EDIT 0 TYPE MIXTURE ;

ECHO "terminee" ; 
END: ;
