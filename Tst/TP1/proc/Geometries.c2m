*----
*
*  Input data   :
*
*  Output data  :
*    Geo1 :  Geometry used for NXT tracking, PIJ and Flux calculation
*----

PARAMETER Geo1 Geo2 ::  
::: LINKED_LIST Geo1 Geo2 ; ;

*----
*  Modules used in this procedure
*----
MODULE UTL: DELETE: END: GEO: ;
*----
* Radius calculations
*----
REAL R4 := 0.40958 ;
REAL R1 := R4 0.5 SQRT * ;
REAL R2 := R4 0.8 SQRT * ;
REAL R3 := R4 0.95 SQRT * ;
REAL RG := 0.4798 ; 

*---- 
*  Assembly with one enrichment fuel pins and four crowns by fuel pin 
*----
Geo1 := GEO: :: CAR2D 10 10
  X- DIAG X+ REFL Y- SYME Y+ DIAG
  CELL 
! Colonnes                                  ! Lignes
!   9   10  11  12  13  14  15  16  17  lame !
    TI  C1  C1  T1  C1  C1  T1  C1  C1  CLD  !  9
        C1  C1  C1  C1  C1  C1  C1  C1  CLD  ! 10
            C1  C1  C1  C1  C1  C1  C1  CLD  ! 11
                T1  C1  C1  T1  C1  C1  CLD  ! 12
                    C1  C1  C1  C1  C1  CLD  ! 13
                        T1  C1  C1  C1  CLD  ! 14
                            C1  C1  C1  CLD  ! 15
                                C1  C1  CLD  ! 16
                                    C1  CLD  ! 17
                                        CLC  ! lame
  *----
  *  Fuel cell      1      
  *----
  ::: C1 := GEO: CARCEL 6
    MESHX    0.00    1.25984 MESHY    0.00    1.25984
    RADIUS  0.0  <<R1>>  <<R2>>  <<R3>>  <<R4>>  <<RG>> 0.6250
    MIX        1      2     3       4      5      6   6 ;
  *----
  *  water central pin
  *----
  ::: TI := GEO: CARCEL 2 
    MESHX    0.00    1.25984 MESHY    0.00    1.25984
    RADIUS  0.0 0.560 0.620
    SPLITR 3 1
    MIX 6 5 6 ;
  *---- 
  *  other water pins
  *----
  ::: T1 := GEO: TI
    MIX 6 5 6 ;
  *----
  *  water surrounding
  *----
  ::: CLD := GEO: CAR2D 1 1
    MESHX    0.00    0.25 MESHY    0.00    1.25984
    MIX     6 ;
  *----
  *  water right up corner
  *----
  ::: CLC := GEO: CAR2D 1 1
    MESHX    0.00    0.25 MESHY    0.00    0.25
    MIX     6 ;
    ;

 Geo2 := GEO: Geo1 :: 
  MERGE 2  1  1  3  1  1  3  1  1  4
           1  1  1  1  1  1  1  1  4
              1  1  1  1  1  1  1  4
                 3  1  1  3  1  1  4
                    1  1  1  1  1  4
                       3  1  1  1  4
                          1  1  1  4
                             1  1  4
                                1  4
                                   5 
  TURN  A  A  E  A  A  E  A  A  A  A 
           A  E  B  A  E  B  A  A  A
              C  F  G  C  F  G  A  A
                 A  A  E  A  A  A  A
                    A  F  B  A  A  A 
                       A  A  A  A  A
                          A  A  A  A
                             C  A  A
                                A  A 
                                   A ;
    
END: ;
QUIT "LIST" .
