******************************************************************
*                                                                *
* Procedure :  SetMacroFuel.c2m                                  *
* Purpose   :  Creation of MACROLIB object containing materials  *
*              properties                                        *
* Author(s) :  M. Paradis (2021)                                 *
* Modified  :  X. Doligez(2026) for PHELMA Lectures              *
*                                                                *
* MacroFuel := SetMacroFuel McpoFuelMac Fmap ::                  *
*              Pas de variable : ppmB = cst et on ne fait varier *
*              que TFuel 
******************************************************************

PARAMETER MacroFuel McpoFuelMac Fmap ::
      ::: LINKED_LIST
          MacroFuel McpoFuelMac Fmap ; ;

*----
*  Modules and linked_lists
*----
MODULE NCR: END: ;

REAL ppmB ;
:: >>ppmB<< ;

*----
*  Set MacroFuel for UOx 
*----
MacroFuel := NCR: McpoFuelMac Fmap ::
             EDIT 0 MACRO 
             TABLE McpoFuelMac 'UOX' 'burnup'
             MIX 2   
             SET 'ppmB'     <<ppmB>>
             SET 'T-FUEL'     MAP  
             ENDMIX ;

END: ;
QUIT "LIST" .
