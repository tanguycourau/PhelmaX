*---------------------------------------------------------------------------
*
* Premier calcul de coeur UOX
* 1 calcul de flux / keff
* Isotherme
* 100% UOX
*
*---------------------------------------------------------------------------


*---------------------------------------------------------------------------
* Declaration des objets, des fichiers et des procedures
*---------------------------------------------------------------------------

    LINKED_LIST GeoCalc GeoRef 
                Track Fmap
		McpoFuelMac
		McpoRefl
		MacroFuel
		Macrotot
		MacroRefl
		System
		Flux
		STORE
                ; 

    MODULE   TRIVAT: CRE: PSP:  DELETE: END: 
             MACINI: FLUD: TRIVAA: GREP: MSTR: ; 

    PROCEDURE GeoCore GeoFuelMap InitFuelMap SetMacroFuel ;
    
    SEQ_ASCII ImgGeo :: FILE 'Fig1.ps' ;
*---------------------------------------------------------------------------
* Options des calculs
*---------------------------------------------------------------------------
    STRING GeoType  := "UOX" ;       ! A transformer en "HYB" pour coeur UOX/MOX dans les seances libres 		
    REAL   BUCoeur := 45000. ;         ! BU Total du coeur en MWj/t  
    REAL ppmB := 1200.0 ;
    REAL Keff ;

*---------------------------------------------------------------------------
* Donnees macro issues des calculs assemblages
*---------------------------------------------------------------------------
    XSM_FILE   CPOREFL :: FILE 'CPOREFL.xsm' ; 
    McpoRefl := CPOREFL ; 
   
*---------------------------------------------------------------------------
* Geometries 
* GeoRef : Geometrie de reference
* GeoCalc : Geometrie de calcul 
*---------------------------------------------------------------------------
    INTEGER Splitx Splitz   ; 
    REAL LPitch Lame := 1.25984 0.25 ; 
    INTEGER iPavX := 17 ;  
    REAL    dx   := iPavX I_TO_R LPitch * 2.0 Lame * + ; 
    INTEGER MaxR ; 
 
    EVALUATE Splitx Splitz :=  2 1  ;                     !Chaque assemblage est coupe en 2 par 2
    EVALUATE MaxR := iPavX iPavX * 19 * Splitx * Splitx * Splitz * ; 
 
    GeoRef GeoCalc := GeoCore :: <<Splitx>> <<Splitz>> <<MaxR>> <<dx>>  
                                 <<GeoType>> ; 
     
    Track := TRIVAT: GeoRef :: MAXR <<MaxR>> MCFD 2 ; 
    GeoRef := DELETE: GeoRef ;  
    Fmap GeoCalc := GeoFuelMap GeoCalc :: <<Splitx>> <<Splitz>> 
					 <<dx>> <<GeoType>> ;
					 
*---------------------------------------------------------------------------
* Chargement des tables multiparametrees 
*---------------------------------------------------------------------------
      				
    MacroRefl := CRE: McpoRefl :: EDIT 0 NMIX 2  
                                  READ COMPO McpoRefl  
                                  MIX  1 'MIXREFL    1'  
                                  ENDMIX ;
    
    SEQ_BINARY CPOFuelMac :: FILE 'MCPOUOX.bin' ;  ! Section Tabulee en BU&Bore uniquement
    McpoFuelMac := CPOFuelMac ;  
    
    Fmap := InitFuelMap Fmap :: <<BUCoeur>> <<ppmB>> ;
   
    MacroFuel := SetMacroFuel McpoFuelMac Fmap :: <<ppmB>> ;
    
   
*---------------------------------------------------------------------------
* Calcul du keff 
*---------------------------------------------------------------------------
   
    Macrotot GeoCalc := MACINI: GeoCalc MacroRefl MacroFuel ;
    
    System := TRIVAA: Macrotot Track ;
    
    Flux := FLUD: System Track ::
            EDIT 0 ADI 1 EXTE 75 ;

*---------------------------------------------------------------------------
* Sauvegarde des resultats de calcul
*---------------------------------------------------------------------------

    GREP: Flux :: GETVAL 'K-EFFECTIVE' 1 >>Keff<< ;    
    STORE := MSTR: ::  
             PUT 1 1 1 "K-EFFECTIVE" <<Keff>>   
             PUT 1 1 1 "ppmB =" <<ppmB>> ; 


    SEQ_ASCII stored :: FILE './stored.txt' ;  
    stored := STORE ; 

END: ; 
QUIT "LIST" . 
